{
  "name": "links.thingelstad.xyz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Linking Things",
  "author": "Jamie Thingelstad",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && pagefind --site dist --glob \"links/*/index.html\"",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py'",
    "lint": "eslint src tools tests *.mjs --max-warnings 0",
    "format": "prettier --write src tools/*.mjs tests/*.mjs *.mjs *.json .prettierrc.json README.md AGENTS.md",
    "format:check": "prettier --check src tools/*.mjs tests/*.mjs *.mjs *.json .prettierrc.json README.md AGENTS.md",
    "sync": "python3 tools/sync.py",
    "join": "python3 tools/join_issues.py",
    "validate:data": "python3 tools/validate_data.py",
    "validate:site": "python3 tools/validate-site.py",
    "sites:sync": "node tools/sync-shared.mjs",
    "sites:check": "node tools/sync-shared.mjs --check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8",
    "markdown-it": "^15.0.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.6.5",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "pagefind": "1.5.2",
    "playwright": "^1.64.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript-eslint": "8.71.2"
  },
  "engines": {
    "node": ">=24 <27"
  }
}
