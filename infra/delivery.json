{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "links.thingelstad.xyz main-only GitHub OIDC promotion of tested AWS publisher packages",
  "Parameters": {
    "PublisherBucket": {
      "Type": "String"
    },
    "PublisherProject": {
      "Type": "String"
    }
  },
  "Resources": {
    "DeploymentRole": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "cfn-lint": {
          "config": {
            "ignore_checks": ["W3037"]
          }
        }
      },
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:oidc-provider/token.actions.githubusercontent.com"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": "repo:jthingelstad@5351/links.thingelstad.xyz@1431527619:ref:refs/heads/main"
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "PromotePublisher",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": ["s3:PutObject"],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${PublisherBucket}/releases/current.zip"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "codebuild:StartBuild",
                    "codebuild:BatchGetBuilds"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:codebuild:${AWS::Region}:${AWS::AccountId}:project/${PublisherProject}"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "DeploymentRoleArn": {
      "Value": {
        "Fn::GetAtt": ["DeploymentRole", "Arn"]
      },
      "Description": "DeploymentRole GitHub OIDC identity"
    }
  }
}
