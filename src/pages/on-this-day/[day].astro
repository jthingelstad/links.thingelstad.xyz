---
// One calendar day across the years, in Central: the links saved on it,
// grouped by year, newest year first, each year in the order saved. Previous
// and next go round the calendar. Not in the search index (Pagefind indexes
// the record pages only).
import Layout from '../../layouts/Layout.astro';
import LinkList from '../../components/LinkList.astro';
import {
  type Link,
  linksByMonthDay,
  monthDayLabel,
  monthDays,
  monthPath,
  onThisDayPath,
  plural,
  timeLabel,
} from '../../lib/data';

export function getStaticPaths() {
  return monthDays.map((day, i) => ({
    params: { day },
    props: {
      previous: monthDays[(i - 1 + monthDays.length) % monthDays.length],
      next: monthDays[(i + 1) % monthDays.length],
    },
  }));
}
interface Props {
  previous: string;
  next: string;
}
const { previous, next } = Astro.props;
const day = Astro.params.day!;
const list = linksByMonthDay.get(day) ?? [];
const byYear = new Map<number, Link[]>();
for (const link of list)
  byYear.set(link.year, [...(byYear.get(link.year) ?? []), link]);
const groups = [...byYear].sort(([a], [b]) => b - a);
const label = monthDayLabel(day);
const month = Number(day.slice(0, 2));
const span =
  groups.length === 1
    ? `in ${groups[0][0]}`
    : `in ${groups.length} different years, from ${groups[groups.length - 1][0]} to ${groups[0][0]}`;
const all = `${onThisDayPath()}#days`;
---

<Layout
  title={`${label} · On this day · Linking Things`}
  description={`The ${plural(list.length, 'link')} Jamie Thingelstad saved on ${label}, ${span}.`}
>
  <p class="kicker">
    <a href={all}>On this day</a>
  </p>
  <h1 class="page-title">{label}</h1>
  <p class="lede">
    {plural(list.length, 'link')} saved on {label}, {span}. Days are US Central.
  </p>
  <nav class="day-nav" aria-label="Days">
    <a href={onThisDayPath(previous)} rel="prev">
      ← {monthDayLabel(previous)}
    </a>
    <a href={all}>Every day</a>
    <a href={onThisDayPath(next)} rel="next">
      {monthDayLabel(next)} →
    </a>
  </nav>
  {groups.map(([year, links]) => (
    <section class="month" id={`y${year}`}>
      <h2>
        <a href={monthPath(year, month)}>{year}</a>{' '}
        <span class="meta">{plural(links.length, 'link')}</span>
      </h2>
      <LinkList links={links} snippet date={(link) => timeLabel(link.saved)} />
    </section>
  ))}
  <nav class="day-nav" aria-label="More days">
    <a href={onThisDayPath(previous)}>← {monthDayLabel(previous)}</a>
    <a href={all}>Every day</a>
    <a href={onThisDayPath(next)}>{monthDayLabel(next)} →</a>
  </nav>
</Layout>
