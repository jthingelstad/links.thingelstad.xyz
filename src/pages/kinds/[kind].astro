---
// The links of one kind (src/lib/kinds.ts), newest first and grouped by the
// Central year they were saved, with the kind's own RSS and JSON Feed pair
// (src/lib/feeds.ts). A page lists at most KIND_PAGE_LIMIT links: "page",
// everything that is no other kind, holds most of the archive, and all of it
// on one page would be megabytes. Every link is still on its year's page.
import Layout from '../../layouts/Layout.astro';
import LinkList from '../../components/LinkList.astro';
import {
  type Kind,
  feedPath,
  kindPath,
  kinds,
  linksByKind,
  number,
  plural,
} from '../../lib/data';
import { feedAlternates, kindFeed } from '../../lib/feeds';
import { kindWords } from '../../lib/kinds';

const KIND_PAGE_LIMIT = 1000;

export function getStaticPaths() {
  return kinds.map((kind) => ({ params: { kind }, props: { kind } }));
}
interface Props {
  kind: Kind;
}
const { kind } = Astro.props;
const words = kindWords[kind];
const list = [...(linksByKind.get(kind) ?? [])].reverse();
const shown = list.slice(0, KIND_PAGE_LIMIT);
const byYear = new Map<number, typeof list>();
for (const link of shown)
  byYear.set(link.year, [...(byYear.get(link.year) ?? []), link]);
const feed = kindFeed(kind);
---

<Layout
  title={`${words.title} · Linking Things`}
  description={`${plural(list.length, 'link')} of the kind ${words.name.toLowerCase()} that Jamie Thingelstad has saved. ${words.about}`}
  alternates={feedAlternates(feed)}
>
  <p class="kicker">
    <a href="/kinds/">Kind</a>
  </p>
  <h1 class="page-title">{words.title}</h1>
  <p
    class="lede"
    data-count={String(list.length)}
    data-shown={String(shown.length)}
  >
    {words.about}{' '}
    {shown.length < list.length ? (
      <>
        {plural(list.length, 'link')}; the newest {number(shown.length)} are
        here, and every one is on its year's page in <a href="/years/">Years</a>
        .
      </>
    ) : (
      <>{plural(list.length, 'link')}, newest first.</>
    )}{' '}
    The newest are also a feed (
    <a href={feedPath('rss', kindPath(kind))}>RSS</a> or{' '}
    <a href={feedPath('json', kindPath(kind))}>JSON Feed</a>).
  </p>
  <nav class="year-nav" aria-label="Kinds">
    {kinds.map((k) => (
      <a href={kindPath(k)} aria-current={k === kind ? 'page' : undefined}>
        {kindWords[k].title}
      </a>
    ))}
  </nav>
  {[...byYear].map(([year, links]) => (
    <section class="month" id={String(year)}>
      <h2>
        {year} <span class="meta">{plural(links.length, 'link')}</span>
      </h2>
      <LinkList links={links} compact />
    </section>
  ))}
</Layout>
