---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not found · Linking Things" notFound>
  <h1 class="page-title">Not found</h1>
  <p class="lede">
    No page here. If this was a link's record, its address is the first twelve
    characters of the md5 of the URL as it was saved; a link that was never
    saved, or is no longer public, has none.
  </p>
  <p>
    <a href="/search/">Search the links</a> or start from{' '}
    <a href="/">the front page</a>.
  </p>
</Layout>
