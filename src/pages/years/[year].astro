---
// One year of saving, by month, oldest first: the date spine, kept to a page
// per year, with the year in bars at its head (YearBars.astro). A lens
// (Lens.astro): the sky beside it lights the year's links, laid out by Time,
// with the years either side as chips.
import Layout from '../../layouts/Layout.astro';
import LinkList from '../../components/LinkList.astro';
import Lens from '../../components/Lens.astro';
import YearBars from '../../components/YearBars.astro';
import type { Lens as LensFacts } from '../../lib/lens';
import { centralDate } from '../../lib/day';
import {
  type Link,
  appearances,
  linksByYear,
  monthAnchor,
  monthNames,
  number,
  plural,
  yearPath,
  years,
} from '../../lib/data';

export function getStaticPaths() {
  return years.map((year) => ({ params: { year: String(year) } }));
}
const year = Number(Astro.params.year);
const list = linksByYear.get(year) ?? [];
const months = monthNames
  .map((name, i) => ({
    name,
    month: i + 1,
    links: list.filter((link) => link.month === i + 1),
  }))
  .filter((m) => m.links.length);
const notes = list.filter((link) => link.hasNote).length;
// The year's count is on its card once the year is over (Jamie: "counts on
// issues and finished years only").
const finished = year < Number(centralDate(new Date()).slice(0, 4));
const inIssues = list.filter((link) => appearances.has(link.id)).length;
const day = (link: Link) =>
  `${monthNames[link.month - 1].slice(0, 3)} ${Number(link.day.slice(8))}`;
const lens: LensFacts = {
  kind: 'set',
  label: `Lens: ${year}`,
  view: 'time',
  section: '/years/',
  chips: [
    ...(years.includes(year - 1)
      ? [
          {
            href: yearPath(year - 1),
            label: String(year - 1),
            rel: 'prev' as const,
          },
        ]
      : []),
    ...(years.includes(year + 1)
      ? [
          {
            href: yearPath(year + 1),
            label: String(year + 1),
            rel: 'next' as const,
          },
        ]
      : []),
  ],
};
---

<Layout
  title={`${year} · Linking Things`}
  description={`The ${plural(list.length, 'link')} Jamie Thingelstad saved in ${year}, by month.`}
  feed
  card={{
    kicker: 'Year',
    headline: String(year),
    count: finished ? list.length : 0,
    ids: list.map((link) => link.id),
  }}
  lens
>
  <Lens lens={lens}>
    <p class="kicker">Year</p>
    <h1 class="page-title">{year}</h1>
    <p class="lede">
      {plural(list.length, 'link')} saved in {year}; {number(notes)} with a note
      {inIssues > 0 && `, ${number(inIssues)} in a Weekly Thing`}.
    </p>
    <nav class="year-nav" aria-label="Years">
      {years.map((y) => (
        <a href={yearPath(y)} aria-current={y === year ? 'page' : undefined}>
          {y}
        </a>
      ))}
    </nav>
    <YearBars year={year} links={list} />
    {months.map((m) => (
      <section class="month" id={monthAnchor(year, m.month)}>
        <h2>
          {m.name} <span class="meta">{plural(m.links.length, 'link')}</span>
        </h2>
        <LinkList links={m.links} compact date={day} entries />
      </section>
    ))}
  </Lens>
</Layout>
