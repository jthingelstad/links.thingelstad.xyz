---
// The front page is the sky (Jamie, 2026-10-31: "Approved: build Linking
// Things direction A in three phases (sky landing, ...)"; docs/DIRECTION.md,
// "The front page"): every link a star, standing back over the whole sky,
// with Find in the bar lighting the stars whose titles and sites have the
// words, Meaning and Time, Play, and the ways in. The whole sky's card says
// what it is and carries the quote of the day from content/quotes.md. On a
// phone, or without WebGL, it is Doors, opening on the newest link with a
// note. The stage is src/components/SkyStage.astro, drawn by
// src/scripts/sky.ts.
//
// Without the script, or when the stars do not load, the page is the plain
// front door (data-sky-plain): the wordmark, a search form that goes to
// /search/, the count, Surprise me and the ways in, and the day's quote.
// Every quote is in the page and the build shows the day it runs; the script
// below turns to today's (day.ts), since the page may be days old.
import Layout from '../layouts/Layout.astro';
import SkyStage from '../components/SkyStage.astro';
import {
  aboutPath,
  counts,
  newestPath,
  number,
  surprisePath,
  years,
} from '../lib/data';
import { dayIndex } from '../lib/day';
import { quotes } from '../lib/quotes';
import { WHOLE_SKY } from '../lib/card';
import '../styles/sky.css';
const pick = quotes.length ? dayIndex(quotes.length) : -1;
const entries = [
  [newestPath, 'Newest'],
  ['/years/', 'Years'],
  ['/issues/', 'Issues'],
  ['/hosts/', 'Sites'],
  ['/kinds/', 'Kinds'],
  ['/stats/', 'Stats'],
  [aboutPath, 'About'],
];
---

<Layout home card={WHOLE_SKY}>
  <h1 class="sr-only">Linking Things</h1>
  <SkyStage home />
  <div class="home" data-sky-plain>
    <p class="home-wordmark" aria-hidden="true">
      Linking Things
    </p>
    <form class="search-form home-search" role="search" action="/search/">
      <label class="sr-only" for="home-query">
        Search the links
      </label>
      <div class="search-box">
        <input
          id="home-query"
          name="q"
          type="search"
          spellcheck="false"
          placeholder="DNS, Stratechery, site:kottke.org, year:2012"
        />
      </div>
      <button type="submit">Search</button>
    </form>
    <p class="home-count">
      Searching <b>{number(counts.links)}</b> links saved from {years[0]} to{' '}
      {years[years.length - 1]}
    </p>
    <a class="home-surprise" href={surprisePath} rel="nofollow">
      Surprise me
    </a>
    <nav class="home-entries" aria-label="Ways in">
      <ul>
        {entries.map(([href, label]) => (
          <li>
            <a href={href}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
    {quotes.map((quote, i) => (
      <figure class="home-quote" data-quote hidden={i !== pick}>
        <blockquote cite={quote.source}>
          {quote.words.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </blockquote>
        <figcaption>
          <a href={quote.source}>{quote.who}</a>
        </figcaption>
      </figure>
    ))}
  </div>
</Layout>

<script>
  import { initSky } from '../scripts/sky';
  initSky();
</script>

<script>
  // Today's quote, in the sky's card and the plain door alike: each holds
  // every quote in the same order.
  import { dayIndex } from '../lib/day';
  for (const holder of document.querySelectorAll<HTMLElement>(
    '[data-sky], [data-sky-plain]',
  )) {
    const figures = holder.querySelectorAll<HTMLElement>('[data-quote]');
    const today = figures.length ? dayIndex(figures.length) : -1;
    figures.forEach((figure, i) => (figure.hidden = i !== today));
  }
</script>

<script>
  // On this day is the reader's today, in Central.
  import { centralDate } from '../lib/day';
  import { onPath } from '../lib/paths';
  const day = centralDate(new Date());
  for (const link of document.querySelectorAll<HTMLAnchorElement>(
    '[data-today]',
  ))
    link.href = onPath(Number(day.slice(5, 7)), Number(day.slice(8)));
</script>
