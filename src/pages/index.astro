---
// The front door is a search box (Jamie, 2026-10-23: "very much like
// Google's front page, where it's just a search box"): the wordmark, the
// box, how many links are in the index, a row of ways in for someone who
// does not know what to search for, and a quote of the day from
// content/quotes.md when it has one. The box suggests as /search/'s does and
// shows the first five links that match under it (src/scripts/home.ts);
// Enter with nothing chosen searches on /search/, and without JavaScript it
// is a plain form. The newest links are on /newest/. Surprise me, under the
// count, goes to one record at random (surprise.astro).
//
// Every quote is in the page and the build shows the day it runs; the script
// turns to today's (day.ts), since the page may be days old. With no quotes
// nothing renders and the script finds nothing to do.
import Layout from '../layouts/Layout.astro';
import {
  counts,
  feedPath,
  newestPath,
  number,
  skyPath,
  suggestPath,
  surprisePath,
  years,
} from '../lib/data';
import { dayIndex } from '../lib/day';
import { quotes } from '../lib/quotes';
const pick = quotes.length ? dayIndex(quotes.length) : -1;
const entries = [
  [newestPath, 'Newest'],
  [skyPath, 'Sky'],
  ['/years/', 'Years'],
  ['/hosts/', 'Hosts'],
  ['/kinds/', 'Kinds'],
  ['/issues/', 'Issues'],
  ['/stats/', 'Stats'],
  [feedPath('rss'), 'Feed'],
];
---

<Layout home>
  <div class="home">
    <h1 class="home-wordmark">Linking Things</h1>
    <form
      class="search-form home-search"
      role="search"
      action="/search/"
      data-home-search
      data-suggest={suggestPath}
    >
      <label class="sr-only" for="home-query">
        Search the links
      </label>
      <div class="search-box">
        <input
          id="home-query"
          name="q"
          type="search"
          autocomplete="off"
          spellcheck="false"
          placeholder="DNS, Stratechery, site:kottke.org, year:2012"
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-controls="home-suggest"
        />
        <ul
          id="home-suggest"
          class="search-suggest"
          role="listbox"
          aria-label="Suggestions and links"
          hidden
          data-search-suggest
        ></ul>
      </div>
      <button type="submit">Search</button>
    </form>
    <p class="sr-only" aria-live="polite" data-home-status></p>
    <p class="home-count">
      Searching <b>{number(counts.links)}</b> links saved from {years[0]} to{' '}
      {years[years.length - 1]}
    </p>
    <a class="home-surprise" href={surprisePath} rel="nofollow">
      Surprise me
    </a>
    <nav class="home-entries" aria-label="Ways in">
      <ul>
        {/* Topics: a later phase (DIRECTION.md, "Topics"). When /topics/ is
             built its entry goes first in this row, as Topics; until then
             nothing renders for it. */}
        {entries.map(([href, label]) => (
          <li>
            <a href={href}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
    {quotes.map((quote, i) => (
      <figure class="home-quote" data-quote hidden={i !== pick}>
        <blockquote cite={quote.source}>
          {quote.words.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </blockquote>
        <figcaption>
          <a href={quote.source}>{quote.who}</a>
        </figcaption>
      </figure>
    ))}
  </div>
</Layout>

<script>
  import { initHome } from '../scripts/home';
  initHome();
</script>

<script>
  import { dayIndex } from '../lib/day';
  const figures = document.querySelectorAll<HTMLElement>('[data-quote]');
  const today = figures.length ? dayIndex(figures.length) : -1;
  figures.forEach((figure, i) => (figure.hidden = i !== today));
</script>
