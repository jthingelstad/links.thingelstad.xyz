---
// Every page: the shared type (shared/tokens.css, vendored), the "Jamie's
// sites" strip, the header (not on the front page, where the sky's bar holds
// the wordmark and the ways in), and the footer with Jamie's h-card and the About link. The site's
// feeds are advertised on every page, a page's own feeds before them. No
// script runs here but Tinylytics, in the production build only
// (Analytics.astro), and a lens page's mark (`lens`); the search page adds
// Pagefind's.
import '../../shared/tokens.css';
import '../styles/global.css';
import inter from '../../shared/fonts/inter-latin-wght-normal.woff2?url';
import interTight from '../../shared/fonts/inter-tight-latin-wght-normal.woff2?url';
import { owner, sitesStrip } from '../lib/sites';
import { siteFeedAlternates } from '../lib/feeds';
import Analytics from '../components/Analytics.astro';
interface Props {
  title?: string;
  description?: string;
  alternates?: { type: string; href: string; title?: string }[];
  // The 404 page: served at any address, so it names none.
  notFound?: boolean;
  // A page too thin for a search engine (data.ts, unindexed): readers keep
  // it, crawlers follow its links but leave it out of their index.
  noindex?: boolean;
  // The front page: the sky is the page, so no site header.
  home?: boolean;
  // A lens page (Lens.astro): where the script and WebGL are, <html> is
  // marked before anything draws, so the page opens beside the sky, at
  // night, without the header (the sky's bar holds the wordmark and the
  // ways in), rather than turning into it once the script runs.
  lens?: boolean;
  // A record's own share card (lib/card.ts); every other page shares the
  // front page.
  image?: { url: string; alt: string };
  // A page that lists records (newest, a host, a kind, a year, an issue):
  // main is an h-feed, named by the title, whose rows are h-entries
  // (LinkList's `entries`). Never on a record, which is an h-entry itself.
  feed?: boolean;
}
const SITE_NAME = 'Linking Things';
const {
  title = SITE_NAME,
  description = 'Every link Jamie Thingelstad has saved since 2005: a searchable, connected database of twenty-one years of curation.',
  alternates = [],
  notFound = false,
  noindex = false,
  home = false,
  lens = false,
  feed = false,
  image = {
    url: new URL('/share.jpg', Astro.site).href,
    alt: 'The Linking Things front page: every link Jamie Thingelstad has saved since 2005 as a sky of stars, placed by what each one says',
  },
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// The sky is the front page, so the wordmark goes to it; /sky/ stays, with
// its constellations, but leaves the header. Hosts are Sites to a reader
// (Jamie, 2026-10-31); the URLs keep /hosts/.
const sections = [
  ['/search/', 'Search'],
  ['/years/', 'Years'],
  ['/issues/', 'Issues'],
  ['/topics/', 'Topics'],
  ['/hosts/', 'Sites'],
  ['/kinds/', 'Kinds'],
  ['/stats/', 'Stats'],
];
const current = (href: string) =>
  Astro.url.pathname.startsWith(href) ? 'page' : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {notFound ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link
      rel="preload"
      href={inter}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={interTight}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    {owner.rel_me.map((href) => (
      <link rel="me" href={href} />
    ))}
    {[...alternates, ...siteFeedAlternates].map((alt) => (
      <link rel="alternate" type={alt.type} title={alt.title} href={alt.href} />
    ))}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    {!notFound && <meta property="og:url" content={canonical} />}
    {/* A record's card, or the front page (tools/share-image.mjs) for the rest. */}
    <meta property="og:image" content={image.url} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#131316"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* Tinylytics loads at the end of the body (Analytics.astro). */}
    {lens && <script is:inline>
      if ('WebGLRenderingContext' in window) {
        document.documentElement.setAttribute('data-lens', '');
        for (const meta of document.querySelectorAll(
          'meta[name="theme-color"]',
        )) {
          meta.dataset.day = meta.content;
          meta.content = '#0c1428';
        }
      }
    </script>}
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <nav class="sites-strip" aria-label="Jamie Thingelstad">
      <div class="sites-strip__inner">
        <span class="sites-strip__label">Jamie Thingelstad</span>
        <ul class="sites-strip__list">
          {sitesStrip.map((item) => (
            <li
              class:list={[
                'sites-strip__item',
                `sites-strip__item--${item.id}`,
                { 'sites-strip__item--current': item.current },
              ]}
            >
              <a
                href={item.href}
                title={item.description}
                aria-current={item.current ? 'true' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
    {!home && (
      <header class="site-header">
        <a class="wordmark" href="/">
          Linking Things
        </a>
        <nav aria-label="Site">
          {sections.map(([href, label]) => (
            <a href={href} aria-current={current(href)}>
              {label}
            </a>
          ))}
        </nav>
      </header>
    )}
    <main id="main" class:list={['site-main', { 'h-feed': feed }]}>
      <slot />
      {feed && (
        <>
          <data class="p-name" value={title}></data>
          <data class="u-url" value={canonical}></data>
        </>
      )}
    </main>
    <footer class="site-footer">
      <p>
        Every link saved since 2005 by{' '}
        <a class="h-card" href={owner.url} rel="me author">
          <img
            class="u-photo"
            src={owner.avatar}
            alt=""
            width="24"
            height="24"
          />
          <span class="p-name">{owner.name}</span>
          <data class="u-url" value={owner.url}></data>
          <data class="p-note" value={owner.note}></data>
        </a>
        , as a database: one page per link, and what connects them. Times are US
        Central. <a href="/about/">About</a>
      </p>
    </footer>
    <Analytics />
  </body>
</html>
