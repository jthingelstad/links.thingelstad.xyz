---
// A list of saved links: the title opens the record, then host and date in
// Central, and a chip when the link was in a Weekly Thing.
//
// With `entries`, each row is an h-entry (p-name and u-url on the title,
// which opens the record, and dt-published on the date), for a page whose
// main is an h-feed (Layout's `feed`). It is off by default because the
// record page lists links inside its own h-entry, where rows would read as
// its children.
import {
  type Link,
  appearances,
  issueLabel,
  linkPath,
  noteText,
  shortDateLabel,
} from '../lib/data';
interface Props {
  links: Link[];
  compact?: boolean;
  host?: boolean;
  snippet?: boolean;
  date?: (link: Link) => string;
  entries?: boolean;
}
const {
  links,
  compact = false,
  host = true,
  snippet = false,
  date = (link: Link) => shortDateLabel(link.saved),
  entries = false,
} = Astro.props;
---

<ul class:list={['link-list', { compact }]}>
  {links.map((link) => {
    const issues = appearances.get(link.id);
    return (
      <li class={entries ? 'h-entry' : undefined}>
        <a
          class:list={['title', { 'p-name u-url': entries }]}
          href={linkPath(link.id)}
        >
          {link.shown}
        </a>
        <span class="meta">
          {host && `${link.host} · `}
          {entries ? (
            <time class="dt-published" datetime={link.saved}>
              {date(link)}
            </time>
          ) : (
            date(link)
          )}
          {issues && (
            <>
              {' '}
              <span class="chip">{issueLabel(issues[0].issue)}</span>
            </>
          )}
        </span>
        {snippet && link.hasNote && (
          <p class="snippet">{noteText(link, 180)}</p>
        )}
      </li>
    );
  })}
</ul>
