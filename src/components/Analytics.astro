---
// Tinylytics (design/tinylytics.md): one script, in the production build
// only. The gate is the POAP site's. The deploy workflow builds with
// PUBLIC_TINYLYTICS_ENABLED=true; every other build (dev, preview, tests, a
// plain npm run build) carries no reference to tinylytics.app at all, and
// tools/validate-site.py fails if one does. Even the production build loads
// the script only on links.thingelstad.xyz, so serving dist/ anywhere else
// sends nothing. The tag is Tinylytics' shared script, keyed by data-site,
// with no query parameters: widgets and options (custom kudos, which writes
// only the count into each Kudos button that Kudos.astro draws itself) are
// the site's Tinylytics settings.
const analytics =
  import.meta.env.PROD && import.meta.env.PUBLIC_TINYLYTICS_ENABLED === 'true';
---

{analytics && <script is:inline>
  if (location.hostname === 'links.thingelstad.xyz') {
    const script = document.createElement('script');
    script.defer = true;
    script.src = 'https://tinylytics.app/js/script.js';
    script.dataset.site = 'x4A9AVd_xma4hyT9xLZw';
    document.documentElement.dataset.tinylytics = 'on';
    document.body.append(script);
  }
</script>}
